# GEMINI_API_KEY: Required for Gemini AI API calls (Phase 2 candidate only; unused in MVP).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Fix Lagos Feature Flags (Working Rule #6)
FF_SMS_PROVIDER="console_fake"
FF_VIDEO_UPLOAD="true"
FF_LASRRA_OFFICIAL_VERIFY="false"

# Database & Storage (Local Docker Compose defaults)
DATABASE_URL="postgis://fixlagos:fixlagos_local_dev_only@localhost:5432/fixlagos"
REDIS_URL="redis://localhost:6379/0"
S3_ENDPOINT_URL="http://localhost:9000"
S3_PUBLIC_BUCKET="fixlagos-local-public-media"
S3_PRIVATE_ORIGINS_BUCKET="fixlagos-local-private-originals"
S3_PRIVATE_LASRRA_BUCKET="fixlagos-local-private-lasrra"
PII_HMAC_KEY="replace-in-production-vault-32-byte-secret"
